# Copia questo file in .streamlit/secrets.toml e compila i valori.
# In locale puoi anche lasciare DATABASE_URL vuoto: il tool userà un file JSON locale.

# --- DataForSEO (obbligatorio per scaricare i trend) ---
DATAFORSEO_LOGIN = "tua_email_o_login"
DATAFORSEO_PASSWORD = "tua_password_api"

# --- LLM per la scelta della sorgente Trends ---
# Serve solo la key del provider che usi; si cambia al volo dalla sidebar
# ("🤖 AI"). LLM_PROVIDER = provider preselezionato: openai | gemini | anthropic
LLM_PROVIDER = "openai"

OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-4.1"

GEMINI_API_KEY = "..."
GEMINI_MODEL = "gemini-2.5-flash"

ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_MODEL = "claude-sonnet-5"

# --- Neon Postgres (database dedicato: gedshop_trends) ---
# Prendi la connection string da Neon -> Connection Details, database = gedshop_trends
# Lascia vuoto/rimuovi per usare lo storage JSON locale in fase di test.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/gedshop_trends?sslmode=require"
